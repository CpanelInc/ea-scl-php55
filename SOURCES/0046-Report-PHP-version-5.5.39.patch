Bump the reported PHP version to 5.5.39 to mark the security backports;
no upstream 5.5.39 release exists.

--- a/configure.in
+++ b/configure.in
@@ -119,7 +119,7 @@
 
 PHP_MAJOR_VERSION=5
 PHP_MINOR_VERSION=5
-PHP_RELEASE_VERSION=38
+PHP_RELEASE_VERSION=39
 PHP_EXTRA_VERSION=""
 PHP_VERSION="$PHP_MAJOR_VERSION.$PHP_MINOR_VERSION.$PHP_RELEASE_VERSION$PHP_EXTRA_VERSION"
 PHP_VERSION_ID=`expr [$]PHP_MAJOR_VERSION \* 10000 + [$]PHP_MINOR_VERSION \* 100 + [$]PHP_RELEASE_VERSION`
--- a/main/php_version.h
+++ b/main/php_version.h
@@ -2,7 +2,7 @@
 /* edit configure.in to change version number */
 #define PHP_MAJOR_VERSION 5
 #define PHP_MINOR_VERSION 5
-#define PHP_RELEASE_VERSION 38
+#define PHP_RELEASE_VERSION 39
 #define PHP_EXTRA_VERSION ""
-#define PHP_VERSION "5.5.38"
-#define PHP_VERSION_ID 50538
+#define PHP_VERSION "5.5.39"
+#define PHP_VERSION_ID 50539
